<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/water_deep">

    <!-- 主内容：返回栏 + 滚动设置项 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部返回栏：手表无实体返回键，固定一个返回入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/back"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 远程拉取配置 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/remote_fetch_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/fetchRemoteButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_talk_button"
                    android:gravity="center"
                    android:text="@string/fetch_remote"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- API 地址 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/api_base_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <EditText
                    android:id="@+id/baseUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:hint="@string/api_base_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="3"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />

                <!-- API 协议 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/protocol_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/protocolSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:text="OpenAI 兼容（DeepSeek / 中转站）"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- API 密钥 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/api_key_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <EditText
                    android:id="@+id/keyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:hint="@string/api_key_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="3"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />

                <!-- 模型 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/model_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <EditText
                    android:id="@+id/modelInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:hint="@string/model_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fetchModelsButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_talk_button"
                    android:gravity="center"
                    android:text="@string/fetch_models"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <!-- 默认城市（查天气用） -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/city_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <EditText
                    android:id="@+id/cityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:hint="@string/city_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />

                <!-- 输入方式 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/input_mode_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/inputModeSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:text="@string/input_mode_voice"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- 人格 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/persona_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/personaSelect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:text="@string/persona_title"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- 随重力方向旋转 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_rotate_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/auto_rotate_label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <Switch
                        android:id="@+id/autoRotateSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 大肥鱼大小 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/fish_size_desc"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/fishSizeEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/button_bg"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:text="@string/fish_size_entry_value"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- 保存 -->
                <TextView
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_talk_button"
                    android:gravity="center"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 大肥鱼大小调节浮层：半透明虚化设置页，中间实时预览大肥鱼缩放 -->
    <FrameLayout
        android:id="@+id/fishSizeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D90B1B2E"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/fish_size_overlay_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fishSizePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/fish_size_percent"
                android:textColor="#FF9FC6FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 预览区：中间放大肥鱼 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/previewFish"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fish_idle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="6dp"
                    android:text="@string/fish_size_hint"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </FrameLayout>

            <!-- 调节滑块 -->
            <SeekBar
                android:id="@+id/fishSizeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="120" />

            <!-- 完成 -->
            <TextView
                android:id="@+id/fishSizeDone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_talk_button"
                android:gravity="center"
                android:text="@string/fish_size_done"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
