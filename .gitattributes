# 统一行尾：文本文件自动按 LF 规范化
* text=auto

# ===== 二进制文件（避免 diff 与行尾转换）=====
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.onnx binary
*.so binary
*.jar binary
*.apk binary
*.aab binary
*.zip binary

# ===== 源码与配置统一 LF 行尾 =====
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Windows 批处理保持 CRLF，避免 cmd 解析异常
*.bat text eol=crlf
